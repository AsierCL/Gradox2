# Plantilla de configuracion para el stack de PRODUCCION (docker-compose.yml).
# Copiala a Docker/.env y rellena los valores reales: Docker/.env no se versiona.
#
# ADVERTENCIA: el compose de produccion propaga SPRING_PROFILES_ACTIVE tal cual.
# Si lo dejas en "local", la app arranca con el perfil de desarrollo en una base
# real (Swagger publico, show-sql, sin bootstrap del MASTER). Debe ser "prod".

# Spring profile: SIEMPRE prod en este archivo.
SPRING_PROFILES_ACTIVE=prod

# Base de datos PostgreSQL gestionada (Supabase)
# Usa la cadena de conexion del proyecto, con sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=change-me

# Almacenamiento S3 (Cloudflare R2 en prod, MinIO en dev)
# R2: endpoint del bucket (formato https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT=change-me
# Endpoint publico con el que el navegador descargara los archivos via PreSigned URL.
# Tiene que ser alcanzable desde internet (no un hostname interno del contenedor).
# Si se omite, se usa S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=change-me
S3_REGION=auto
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=gradox2-files
# TTL en segundos de las PreSigned URLs de descarga (por defecto 120)
S3_PRESIGN_TTL_SECONDS=120

# Mail (Gmail SMTP + app password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me@example.com
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

# JWT
# >= 32 bytes: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000

# URL publica de la app. Se usa en los enlaces de verificacion de email y de
# reseteo de contrasena: si no resuelve, el registro queda inutilizable.
# Debe ser la URL real con HTTPS (p. ej. https://tu-app.onrender.com).
APP_BASE_URL=https://change-me.example.com

# Datos demo: SOLO desarrollo. Un despliegue de produccion tiene que dejarlo en
# false, o sembrara usuarios con contrasenas conocidas (incluidos MASTER).
APP_DEMO_SEEDS_ENABLED=false

# Primer MASTER (se usa en el primer arranque; idempotente)
# Si queda vacio no se crea ningun MASTER y el registro solo crea usuarios USER,
# que necesitan la votacion de otros MASTER para ascender: la plataforma
# quedaria sin administradores.
BOOTSTRAP_MASTER_USERNAME=
BOOTSTRAP_MASTER_PASSWORD=
BOOTSTRAP_MASTER_EMAIL=
