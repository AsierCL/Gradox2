# Base de datos
POSTGRES_USER=gradox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gradoxdb

# Spring DataSource
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gradoxdb
SPRING_DATASOURCE_USERNAME=gradox
SPRING_DATASOURCE_PASSWORD=change-me

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me@example.com
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

# Spring profile
SPRING_PROFILES_ACTIVE=local

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000

# App URL (for email verification links) -- PENDIENTE: sustituir por el dominio/IP publico real
# Ej: http://203.0.113.10:8080  (sin HTTPS por ahora)
APP_BASE_URL=http://localhost:8080

# Primer MASTER (solo se usa en el primer arranque en prod; idempotente)
# PENDIENTE: rellenar con credenciales reales antes del primer arranque.
# Se ignoran si ya existe un usuario con ese username/email.
BOOTSTRAP_MASTER_USERNAME=
BOOTSTRAP_MASTER_PASSWORD=
BOOTSTRAP_MASTER_EMAIL=
