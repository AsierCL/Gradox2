# Opcional: configuración SMTP para desarrollo local.
# Copia este archivo a .env y sustituye los valores; .env no se versiona.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me@example.com
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

# CORS para desarrollo local (el frontend corre en otro puerto).
# En produccion el valor por defecto es https://gradox2.github.io.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Sin proxy delante en local: la cabecera X-Forwarded-For no se usa.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
